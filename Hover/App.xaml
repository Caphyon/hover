<Application
    x:Class="ContainerHover.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ContainerHover">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>

      <Color x:Key="AppAccentColor">#FF7C5CFC</Color>
      <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource AppAccentColor}" />
      <SolidColorBrush x:Key="PanelBrush" Color="#F8F8FC" />
    </ResourceDictionary>
  </Application.Resources>
</Application>